# Meta WhatsApp Cloud API
# Use a long-lived System User token for production stability.
WHATSAPP_API_KEY=replace_with_long_lived_meta_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id

# OpenRouter / OpenAI-compatible
OPENAI_API_KEY=replace_with_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Sheets logging
GOOGLE_SHEET_ID=replace_with_google_sheet_id
GOOGLE_CREDENTIALS_JSON=/opt/fabs_chatbot/credentials.json

# Staff handoff number in E.164 format without "+"
HANDOFF_PHONE_NUMBER=923001234567

# Webhook verification token (must match Meta dashboard)
WEBHOOK_VERIFY_TOKEN=replace_with_random_verify_token
