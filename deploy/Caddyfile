your-domain.com {
    reverse_proxy 127.0.0.1:8000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/fabs-chatbot.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
